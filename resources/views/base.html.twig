<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Home{% endblock %} :: phplrt</title>
    <meta name="description" content="{% block description %}phplrt is a parsing toolkit for PHP: a lexer, a PEG parser, a grammar compiler and an error printer. Describe your format in a grammar file and get back tokens, a syntax tree and error messages that point at the exact character.{% endblock %}" />

    {# The canonical address is rebuilt from the route that matched rather than
       copied out of the request, so a query string, a trailing "index.php" or
       anything else appended to the url cannot turn one page into two in an
       index. Error responses are rendered without a route, and those fall back
       to the path as it was asked for. #}
    {% set route = app.request.attributes.get('_route') %}
    {% set canonical = route
        ? url(route, app.request.attributes.get('_route_params')|default({}))
        : app.request.schemeAndHttpHost ~ app.request.pathInfo %}

    {# Both cards read the same two blocks the <title> and the description are
       built from, so a page never has to describe itself twice. #}
    {% set share_title = block('title')|trim %}
    {% set share_text = block('description')|trim %}
    {% set share_image = absolute_url('/img/banner.png') %}

    <link rel="canonical" href="{{ canonical }}" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="phplrt" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:title" content="{{ share_title }}" />
    <meta property="og:description" content="{{ share_text }}" />

    {# The banner is 1200x630, the ratio every card crops to, so it arrives
       whole. The dimensions are spelled out because a client that does not
       know them yet has to fetch the image before it can lay the card out,
       and it will hold the preview back until that finishes. #}
    <meta property="og:image" content="{{ share_image }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="phplrt" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ share_title }}" />
    <meta name="twitter:description" content="{{ share_text }}" />
    <meta name="twitter:image" content="{{ share_image }}" />
    <meta name="twitter:image:alt" content="phplrt" />

    {# Section 19 of the sheet hides a block until the scroll reveals it, and
       it only does so while this class is on the root — with no JavaScript
       everything is simply already where it belongs. It has to be set before
       the first paint, which is why it is inline here instead of a line in
       the bundle at the end of the body. #}
    <script>document.documentElement.className += ' js';</script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    <meta http-equiv="x-dns-prefetch-control" content="on" />

    <link rel="dns-prefetch" href="https://phplrt.org" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Nunito:ital,wght@0,400;0,600;0,700;0,800&display=swap" rel="stylesheet" />

    <link rel="shortcut icon" href="/favicon/x32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon/x32.png" />
    <link rel="apple-touch-icon" sizes="64x64" href="/favicon/x64.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/favicon/x128.png" />
</head>
<body>
    {% block content %}{% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {% include "partials/yandex.html.twig" %}
</body>
</html>
