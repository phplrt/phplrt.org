<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Home{% endblock %} :: phplrt</title>
    <meta name="description" content="{% block description %}A lexer, a PEG parser, a grammar compiler and an error printer for PHP. Describe your format once and get tokens, a tree, and errors that point at the character.{% endblock %}" />

    {# Section 19 of the sheet hides a block until the scroll reveals it, and
       it only does so while this class is on the root — with no JavaScript
       everything is simply already where it belongs. It has to be set before
       the first paint, which is why it is inline here instead of a line in
       the bundle at the end of the body. #}
    <script>document.documentElement.className += ' js';</script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    <meta http-equiv="x-dns-prefetch-control" content="on" />

    <link rel="dns-prefetch" href="https://phplrt.org" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Nunito:ital,wght@0,400;0,600;0,700;0,800&display=swap" rel="stylesheet" />

    <link rel="shortcut icon" href="/favicon/x32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon/x32.png" />
    <link rel="apple-touch-icon" sizes="64x64" href="/favicon/x64.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/favicon/x128.png" />
</head>
<body>
    {% block content %}{% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {% include "partials/yandex.html.twig" %}
</body>
</html>
