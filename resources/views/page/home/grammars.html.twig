{# The template-language example inside contains literal "{{ … }}", so the
   whole chapter is passed through untouched. #}
{% verbatim %}
<!-- ==========================================================================
     03 · Grammars
     ====================================================================== -->
<section class="band band--paper" id="grammars">
    <div class="hold">
        <div class="head rise">
            <span class="chapter">03 · grammars</span>
            <h2 class="title">Three languages, none of them long</h2>
            <p class="lede">
                A grammar is normally shorter than the code you would write to read the
                same thing by hand — and unlike that code, it can be drawn.
            </p>
        </div>

        <div id="examples" class="rise">
            <div class="tabs" data-tabs="examples" role="tablist">
                <button class="tab is-on" type="button" role="tab" aria-selected="true" data-view-key="config">a config format</button>
                <button class="tab" type="button" role="tab" aria-selected="false" data-view-key="filter">filter expressions</button>
                <button class="tab" type="button" role="tab" aria-selected="false" data-view-key="tmpl">a template language</button>
            </div>

            <!-- Config -->
            <div data-view="config">
                <div class="duo duo--lead">
                    <div class="panel panel--night">
                        <div class="panel__bar"><b>config.pp3</b><span class="push">18 lines</span></div>
                        <pre class="code code--fill"><span class="c-dir">%skip</span>  <span class="c-tok">T_WHITESPACE</span>  <span class="c-re">\s++</span>
<span class="c-dir">%skip</span>  <span class="c-tok">T_COMMENT</span>     <span class="c-re">//[^\n]*+</span>

<span class="c-dir">%token</span> <span class="c-tok">T_NUMBER</span>      <span class="c-re">\d++(?:\.\d++)?</span>
<span class="c-dir">%token</span> <span class="c-tok">T_STRING</span>      <span class="c-re">"[^"]*+"</span>
<span class="c-dir">%token</span> <span class="c-tok">T_TRUE</span>        <span class="c-re">true</span>
<span class="c-dir">%token</span> <span class="c-tok">T_FALSE</span>       <span class="c-re">false</span>
<span class="c-dir">%token</span> <span class="c-tok">T_NAME</span>        <span class="c-re">[a-zA-Z_][a-zA-Z0-9_]*+</span>

<span class="c-dir">%pragma</span> root <span class="c-rule">Config</span>

<span class="c-rule">Config</span> <span class="c-op">:</span> <span class="c-rule">Pair</span>()<span class="c-op">*</span> <span class="c-op">;</span>

<span class="c-rule">Pair</span> <span class="c-op">:</span> <span class="c-cap">&lt;T_NAME&gt;</span> <span class="c-str">"="</span> <span class="c-rule">Value</span>() <span class="c-op">;</span>

<span class="c-rule">Value</span>
  <span class="c-op">:</span> <span class="c-cap">&lt;T_NUMBER&gt;</span>
  <span class="c-op">|</span> <span class="c-cap">&lt;T_STRING&gt;</span>
  <span class="c-op">|</span> <span class="c-rule">List</span>()
  <span class="c-op">;</span>

<span class="c-rule">List</span> <span class="c-op">:</span> <span class="c-str">"["</span> (<span class="c-rule">Value</span>() (<span class="c-str">","</span> <span class="c-rule">Value</span>())<span class="c-op">*</span>)<span class="c-op">?</span> <span class="c-str">"]"</span> <span class="c-op">;</span></pre>
                    </div>

                    <div class="stack">
                        <div class="panel">
                            <div class="panel__bar"><b>Value</b><span class="push">an alternation, drawn</span></div>
                            <div class="rr">
                                <!--
                                  Grid (620 × 250). Three branches from the fork at
                                  x=70, corner radius 22, arriving on the left edge of
                                  the nodes at x=150 — each on its own centre line:
                                  y=30, y=125, y=220. (In #5 the third branch ran to
                                  y=198, which is List()'s top-left corner.)
                                  Nodes are 190 wide, so they end at x=340; the three
                                  returns merge at x=442 on y=125.
                                -->
                                <svg viewBox="0 0 620 250" role="img" aria-label="Value is one of: a number, a string, or a list">
                                    <circle class="rr-dot" cx="16" cy="125" r="5"/>
                                    <path class="rr-line rr-line--draw" d="M21,125 H70"/>

                                    <path class="rr-line" d="M70,125 q22,0 22,-22 V52 q0,-22 22,-22 H150"/>
                                    <path class="rr-line" d="M70,125 H150"/>
                                    <path class="rr-line" d="M70,125 q22,0 22,22 V198 q0,22 22,22 H150"/>

                                    <g class="rr-node rr-node--token">
                                        <rect x="150" y="8" width="190" height="44" rx="22"/>
                                        <text x="245" y="31">&lt;T_NUMBER&gt;</text>
                                    </g>
                                    <g class="rr-node rr-node--token">
                                        <rect x="150" y="103" width="190" height="44" rx="22"/>
                                        <text x="245" y="126">&lt;T_STRING&gt;</text>
                                    </g>
                                    <g class="rr-node rr-node--rule">
                                        <rect x="150" y="198" width="190" height="44" rx="22"/>
                                        <text x="245" y="221">List()</text>
                                    </g>

                                    <path class="rr-line" d="M340,30 H398 q22,0 22,22 V103 q0,22 22,22"/>
                                    <path class="rr-line" d="M340,125 H442"/>
                                    <path class="rr-line" d="M340,220 H398 q22,0 22,-22 V147 q0,-22 22,-22"/>

                                    <path class="rr-line rr-line--draw" d="M442,125 H580"/>
                                    <circle class="rr-dot" cx="588" cy="125" r="5"/>
                                </svg>
                            </div>
                            <div class="legend">
                                <span><i class="i-rule"></i>rule</span>
                                <span><i class="i-token"></i>token, kept</span>
                            </div>
                        </div>

                        <div class="panel panel--soft">
                            <div class="panel__bar"><b>reads</b></div>
                            <pre class="code code--paper code--sm">name    <span class="c-op">=</span> <span class="c-str">"phplrt"</span>
version <span class="c-op">=</span> <span class="c-num">4</span>
tags    <span class="c-op">=</span> [<span class="c-str">"php"</span>, <span class="c-str">"peg"</span>]   <span class="c-cm">// comment is hidden</span></pre>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter expressions -->
            <div data-view="filter" hidden>
                <div class="duo duo--lead">
                    <div class="panel panel--night">
                        <div class="panel__bar"><b>filter.pp3</b><span class="push">the search-bar language</span></div>
                        <pre class="code code--fill"><span class="c-dir">%skip</span>  <span class="c-tok">T_WHITESPACE</span> <span class="c-re">\s++</span>

<span class="c-dir">%token</span> <span class="c-tok">T_STRING</span>     <span class="c-re">"[^"]*+"</span>
<span class="c-dir">%token</span> <span class="c-tok">T_NUMBER</span>     <span class="c-re">\d++(?:\.\d++)?</span>
<span class="c-dir">%token</span> <span class="c-tok">T_AND</span>        <span class="c-re">and</span>
<span class="c-dir">%token</span> <span class="c-tok">T_OR</span>         <span class="c-re">or</span>
<span class="c-dir">%token</span> <span class="c-tok">T_FIELD</span>      <span class="c-re">[a-z_][a-z0-9_.]*+</span>

<span class="c-dir">%pragma</span> root <span class="c-rule">Query</span>

<span class="c-cm">// "or" binds looser, so it is read first and
// written in terms of "and" — precedence is nesting</span>
<span class="c-rule">Query</span> <span class="c-op">-&gt;</span> { <span class="c-kw">return</span> <span class="c-cls">Any</span><span class="c-op">::</span><span class="c-fn">of</span>(<span class="c-var">$children</span>); }
  <span class="c-op">:</span> <span class="c-rule">All</span>() (<span class="c-cap">::T_OR::</span> <span class="c-rule">All</span>())<span class="c-op">*</span>
  <span class="c-op">;</span>

<span class="c-rule">All</span> <span class="c-op">-&gt;</span> { <span class="c-kw">return</span> <span class="c-cls">Every</span><span class="c-op">::</span><span class="c-fn">of</span>(<span class="c-var">$children</span>); }
  <span class="c-op">:</span> <span class="c-rule">Test</span>() (<span class="c-cap">::T_AND::</span> <span class="c-rule">Test</span>())<span class="c-op">*</span>
  <span class="c-op">;</span>

<span class="c-rule">Test</span>
  <span class="c-op">:</span> <span class="c-rule">Compare</span>()
  <span class="c-op">|</span> <span class="c-str">"("</span> <span class="c-rule">Query</span>() <span class="c-str">")"</span>
  <span class="c-op">;</span>

<span class="c-cm">// "&lt;=" before "&lt;": first match wins, not longest</span>
<span class="c-rule">Compare</span> <span class="c-op">:</span> <span class="c-cap">&lt;T_FIELD&gt;</span> (<span class="c-str">"&lt;="</span> <span class="c-op">|</span> <span class="c-str">"&gt;="</span> <span class="c-op">|</span> <span class="c-str">"&lt;"</span> <span class="c-op">|</span> <span class="c-str">"&gt;"</span> <span class="c-op">|</span> <span class="c-str">"="</span>) <span class="c-rule">Val</span>() <span class="c-op">;</span>

<span class="c-rule">Val</span> <span class="c-op">:</span> <span class="c-cap">&lt;T_STRING&gt;</span> <span class="c-op">|</span> <span class="c-cap">&lt;T_NUMBER&gt;</span> <span class="c-op">;</span></pre>
                    </div>

                    <div class="stack">
                        <div class="panel panel--soft">
                            <div class="panel__bar"><b>reads</b></div>
                            <pre class="code code--paper code--sm">price &lt; 100 and brand = <span class="c-str">"acme"</span>

stock &gt; 0 or (rating &gt;= 4 and reviews &gt; 10)</pre>
                        </div>

                        <div class="fact">
                            <span class="fact__tag">note</span>
                            <h3>The operators are never declared</h3>
                            <p>
                                <code>"&lt;="</code>, <code>"("</code> and friends declare their tokens
                                where they are read, and an inline token is always discarded — five
                                <code>%token</code> lines saved, none of which needed a name.
                            </p>
                        </div>

                        <div class="fact fact--flat">
                            <span class="fact__tag">why not a regex</span>
                            <h3>Because of the brackets</h3>
                            <p>
                                The moment a language nests, a regular expression stops being able
                                to describe it — and the hand-written reader that replaces it is
                                exactly the code this grammar is instead of.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Template -->
            <div data-view="tmpl" hidden>
                <div class="duo duo--lead">
                    <div class="panel panel--night">
                        <div class="panel__bar"><b>template.pp3</b><span class="push">one lexer per lexical world</span></div>
                        <pre class="code code--fill"><span class="c-cm">// inside {{ … }} the rules are different, so the
// opening token hands the reading to another lexer</span>

<span class="c-dir">%skip</span>  <span class="c-cap">*:</span><span class="c-tok">T_WHITESPACE</span>  <span class="c-re">\s++</span>

<span class="c-dir">%token</span> <span class="c-tok">T_TEXT</span>        <span class="c-re">[^{]++</span>
<span class="c-dir">%token</span> <span class="c-tok">T_OPEN</span>        <span class="c-re">\{\{</span>  <span class="c-op">-&gt;</span> <span class="c-fn">state</span>(code)
<span class="c-dir">%token</span> <span class="c-cap">code:</span><span class="c-tok">T_NAME</span>   <span class="c-re">[a-z_]\w*+</span>
<span class="c-dir">%token</span> <span class="c-cap">code:</span><span class="c-tok">T_DOT</span>    <span class="c-re">\.</span>
<span class="c-dir">%token</span> <span class="c-cap">code:</span><span class="c-tok">T_CLOSE</span>  <span class="c-re">\}\}</span>  <span class="c-op">-&gt;</span> <span class="c-fn">exit</span>()

<span class="c-cm">// kept out of the grammar, but not thrown away</span>
<span class="c-dir">%token</span> <span class="c-tok">T_DOC</span>  <span class="c-re">/\*\*.*?\*/</span>  <span class="c-op">-&gt;</span> <span class="c-fn">channel</span>(docblocks)

<span class="c-cm">// and when no regex will do — write the lexer</span>
<span class="c-dir">%token</span> <span class="c-tok">T_PHP</span>  <span class="c-re">&lt;\?php</span>  <span class="c-op">-&gt;</span> <span class="c-fn">state</span>(php)
<span class="c-dir">%lexer</span> php <span class="c-op">-&gt;</span> { <span class="c-kw">new</span> <span class="c-cls">\App\Lexer\PhpTokenLexer</span>() }

<span class="c-dir">%pragma</span> root <span class="c-rule">Template</span>

<span class="c-rule">Template</span> <span class="c-op">:</span> (<span class="c-cap">&lt;T_TEXT&gt;</span> <span class="c-op">|</span> <span class="c-rule">Hole</span>())<span class="c-op">*</span> <span class="c-op">;</span>

<span class="c-rule">Hole</span> <span class="c-op">:</span> <span class="c-cap">&lt;T_OPEN&gt;</span> <span class="c-op">;</span></pre>
                    </div>

                    <div class="stack">
                        <div class="panel">
                            <div class="panel__bar"><b>lexing</b><span class="push"><code>Hello {{ user.name }}!</code></span></div>
                            <div class="panel__body">
                                <div class="chips">
                                    <span class="chip"><b>Hello&nbsp;</b><span>T_TEXT</span></span>
                                    <span class="chip chip--nest">
                                        <b>{{</b><span>T_OPEN → state(code)</span>
                                        <span class="chip__inner">
                                            <em>user<i>T_NAME</i></em>
                                            <em>.<i>T_DOT</i></em>
                                            <em>name<i>T_NAME</i></em>
                                            <em>}}<i>T_CLOSE</i></em>
                                        </span>
                                    </span>
                                    <span class="chip"><b>!</b><span>T_TEXT</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="fact">
                            <span class="fact__tag">nesting</span>
                            <h3>The outer stream stays flat</h3>
                            <p>
                                Everything the inner lexer read is carried by the token that entered
                                it: <code>$token-&gt;children</code> is the inner stream and
                                <code>$token-&gt;size</code> covers all of it. The grammar only ever
                                names <code>&lt;T_OPEN&gt;</code>.
                            </p>
                        </div>

                        <div class="fact fact--flat">
                            <span class="fact__tag">channels</span>
                            <h3>Docblocks are still there</h3>
                            <p>
                                <code>channel(docblocks)</code> hides a token from the parser and
                                leaves it in the stream — your doc generator reads the same pass.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <p class="note rise" style="margin-top: 20px;">
            <span>the docs ship complete grammars: math, calculator, json, json5, phpdoc types, go! aop pointcuts</span>
            <a class="more" href="/docs/examples/json">browse</a>
        </p>
    </div>
</section>
{% endverbatim %}
