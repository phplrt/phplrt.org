{% extends "base.html.twig" %}

{% block title %}{% apply spaceless %}
    {% if page.title is defined %}
        {{ page.title }}
    {% else %}
        Not Found
    {% endif %}
{% endapply %}{% endblock %}

{% block content %}
    {% include "partials/header.html.twig" with {'page': 'docs'} %}

    <main class="docs">
        <div class="hold docs__in">
            {# The sidebar is a dialog on narrow screens and a column on wide
               ones; one element, two behaviours, so the markup stays single. #}
            <aside class="docs__side" id="docs-side">
                <div class="docs__side-in">
                    {% include "components/search.html.twig" %}
                    {% include "components/menu.html.twig" with {menu: menu, current: current|default('')} %}
                </div>
            </aside>

            <article class="docs__body prose">
                {% if page %}
                    {{ page.content | raw }}
                {% else %}
                    <h1>Page not found</h1>
                    <p>
                        This page has moved or never existed. The chapters on the left are
                        the whole of the documentation — or start from
                        <a href="/docs/guide/introduction">the introduction</a>.
                    </p>
                {% endif %}
            </article>
        </div>
    </main>

    <button class="docs__toggle" type="button" data-docs-toggle aria-controls="docs-side" aria-expanded="false">
        <span>contents</span>
    </button>

    {% include "partials/footer.html.twig" %}
{% endblock %}
