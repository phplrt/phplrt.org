{# Results are fetched from /api/search.json and rendered by docs.js. Without
   JavaScript the field simply does nothing, which is why it is not a form:
   there is no server-rendered result page to submit to. #}
<div class="find" data-find>
    <label class="find__field">
        <svg class="find__icon" viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
            <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>

        <input type="search"
               data-find-input
               autocomplete="off"
               aria-autocomplete="none"
               aria-label="Search the documentation"
               placeholder="Search…" />
    </label>

    <div class="find__out" data-find-out hidden></div>
</div>
