{# ==========================================================================
     Closing
     ====================================================================== #}
<section class="closing band--night" data-night>
    <div class="wave wave--in" aria-hidden="true">
        <svg viewBox="0 0 1920 110" preserveAspectRatio="none">
            <path fill="#e8edf4" d="M0,0H1920V48C1540,116,1160,0,740,54C460,88,230,72,0,46Z"/>
            <path fill="#f4f6fa" d="M0,0H1920V24C1580,90,1180,-14,760,34C450,70,220,52,0,26Z"/>
        </svg>
    </div>

    <div class="hold">
        <h2>Write the rules down once</h2>
        <p>
            A search filter, a routing table, a docblock type, an in-house format nobody
            has published a package for. A grammar takes about half an hour to write, and
            from then on every mistake in the input gets an error that points at the exact
            character.
        </p>

        <div class="cmd">
            <code id="cmd-end">composer require phplrt/phplrt</code>
            <button type="button" data-copy="#cmd-end"><span>copy</span></button>
        </div>

        <div class="closing__acts">
            <a class="act act--brand" href="{{ path('docs.show', {path: docs('quick-start')}) }}">Quick start</a>
            <a class="act" href="/docs">Documentation</a>
        </div>

        {# A dateline rather than a chapter. How long the library has been around
             is worth one line, and two dates cover it: where it came from, and
             when it became something of its own. #}
        <p class="lineage">
            <span>
                <i></i><b>2017</b> · started as a fork of
                <a href="https://github.com/hoaproject/Compiler" rel="noopener">hoa/compiler</a>
            </span>
            <span>
                <i></i><b>2019</b> · a library of its own, developed and maintained ever since
            </span>
        </p>
    </div>
</section>
