{
    "name": "local/twig-highlight-extension",
    "require": {
        "php": "^8.4",
        "tempest/highlight": "^2.27",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Local\\Twig\\HighlightExtension\\": "src"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^10.5|^11.0",
        "vimeo/psalm": "^5.26"
    },
    "autoload-dev": {
        "psr-4": {
            "Local\\Twig\\HighlightExtension\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev",
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
